# Copy this file to .env and fill in what you have. .env is never committed.
# Gemini through Google AI Studio (local development). On Cloud Run, Vertex AI is used instead: see DEPLOY.md.
GEMINI_API_KEY=
# Optional last-resort fallback: Gemma on Fireworks, used only when Gemini does not answer. It runs outside Google Cloud.
# Leave empty to use Google only. The Cloud Run deployment sets FALLBACK_GEMMA=0, so the deployed app never calls it.
FIREWORKS_API_KEY=
# FIREWORKS_MODEL=accounts/fireworks/models/gemma-3-27b-it
# FALLBACK_GEMMA=0
